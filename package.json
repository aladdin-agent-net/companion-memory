{
  "name": "companion-memory",
  "version": "0.2.0",
  "description": "Long-term memory for AI characters, companions and household robots: facts, relationships, speaker-aware access, object locations, episodic timeline and a safety gate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aladdin-agent-net/companion-memory.git"
  },
  "homepage": "https://github.com/aladdin-agent-net/companion-memory#readme",
  "bugs": {
    "url": "https://github.com/aladdin-agent-net/companion-memory/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "tsx examples/basic.ts",
    "example:home": "tsx examples/home-robot.ts"
  },
  "keywords": [
    "llm",
    "memory",
    "roleplay",
    "character",
    "companion",
    "chatbot",
    "long-term-memory",
    "robotics",
    "embodied-ai",
    "home-robot",
    "episodic-memory"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
